# Copy to .env. Java properties syntax: do not quote values or use export.
# Must match AUTH_JWT_SECRET in auth-back-server and image-back-server (HS512: >=64 bytes).
CLOUD_JWT_SECRET=

# local is the default profile. Use dev/prod explicitly for deployment.
# spring.profiles.active=local
STOCK_BATCH_INTERNAL_TOKEN=local-stock-batch-internal-token
# Match zeroq-sensor-gateway; leave blank only when device cloud sync is unused.
ZEROQ_GATEWAY_SHARED_SECRET=
AUTH_ISSUER=http://localhost:9000
